// The settings in JSON format
// Notice: Do not change the section names.

{
	"LogSettings": {
		// whether the log file output should be suppressed
		"SuppressLog": true,
		// Buffer size used for output
		"BufferSize": 1024,
		// The maximum width (in characters) of a printed line
		"WrapLimit": 125,
		// The directory that log file should be
		"LogPath": "Althea.log",
		// The printing levels
		"PrintLevels": [
			"Error",
			"Warning",
			"Information"
		],
		// The buffer levels
		"BufferLevels": [
			"Trace",
			"Debug"
		]
	},

	"PrintSettings": {
		// How many digital numbers will be printed out for a supported data type
		"Precision": 8,
		// The maximum number of lines of printed vectors and sparse matrices
		"ArrayLength": 64,
		// The maximum number of rows of printed matrices
		"MatrixRow": 32,
		// The maximum number of columns of printed matrices
		"MatrixColumn": 32,
		// Whether to print tensor as embedded matrices (like MATHEMATICA) or a list of matrices (like MATLAB)
		"MatrixFormTensor": true
	},

	"ImplementationSettings": {
		// When a new implementation is indicated, whether elder ones will be disposed or not. If the value is true while 'UseRecentImplementation' is true, there may be creations and dispositions of implementation classes. If the value is false and some implementation classes maintains large memory blocks (such as handle of cuBLAS), they will be maintained until this value is set to false.
		"DisposeNotCurrentImplementation": true,
		// Which implementations to use
		"Implementations": {

		}
	}
}
