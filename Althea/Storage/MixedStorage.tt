	/// <typeparam name="TP<#=j + 1#>">The <#=ordinal[j]#> pointer type which implements <see cref="IPointer{TSelf}"/></typeparam>
<# } #>
	public sealed class ReferenceMixedStorage<T, <#=pointerTypes#>> : MixedStorage<T, <#=pointerTypes#>>, IReferenceStorage<T, MixedStorage<T, <#=pointerTypes#>>>
		where T : unmanaged, INumber<T>
		<# for (int j = 1; j <= i; j++) { #>where TP<#=j#> : notnull, IPointer<TP<#=j#>> <# } #>

	{
		/// <summary>
		/// Get the reference <see cref="IStorage"/> of this <see cref="ReferenceMixedStorage{T, <#=pointerTypes#>}"/>
		/// </summary>
		public IStorage? Reference { get; }

		/// <summary>
		/// Get the total offset of this <see cref="ReferenceMixedStorage{T, <#=pointerTypes#>}"/> in bytes compared to <see cref="Reference"/>
		/// </summary>
		public long TotalOffsetInBytes { get; }

		/// <summary>
		/// Create a new <see cref="ReferenceMixedStorage{T, <#=pointerTypes#>}"/> from given base <paramref name="storage"/> and <paramref name="offset"/> and <paramref name="newLength"/>.
		/// </summary>
		/// <param name="storage">The base <see cref="IStorage"/> to refer to</param>
		/// <param name="offset">The offset in <typeparamref name="T"/> compared to <paramref name="storage"/></param>
		/// <param name="newLength">The new presenting length in <typeparamref name="T"/></param>
		/// <exception cref="ArgumentException">If <paramref name="storage"/> is not a <see cref="PureStorageBase{TP}"/></exception>
		/// <exception cref="ArgumentOutOfRangeException">If <paramref name="offset"/> and <paramref name="newLength"/> are out of boundary</exception>
		public ReferenceMixedStorage(IStorage? storage, long offset = 0, long newLength = 0)
		{
			(storage, offset, newLength) = IReferenceStorage<T, MixedStorage<T, <#=pointerTypes#>>>.Create<MixedStorageBase<<#=pointerTypes#>>>(storage, offset, newLength);
			if (storage is not MixedStorageBase<<#=pointerTypes#>> s)
				return;

			this.Reference = storage; this.TotalOffsetInBytes = offset;

			<# for (int j = 1; j < i; j++) { #>PointerSegment<TP<#=j#>> p<#=j#> = default; <# } #>PointerSegment<TP<#=i#>> p<#=i#> = default;
			long offsetEnd = offset + newLength;
			Span<long> lenAccu = stackalloc[] { <# for (int j = 1; j <= i; j++) { #>s.Pointer<#=j#>.LengthInBytes, <# } #> };
			lenAccu.AccumulateSum(lenAccu, inclusive: false);
			int firstNonEmpty = lenAccu.UpperBound(offset), lastNonEmpty = lenAccu.LowerBound(offsetEnd);

<# for (int j = 0; j < i; j++) { int k = j + 1;#>
			if (<#=j#> > firstNonEmpty && <#=j#> < lastNonEmpty)
				p<#=k#> = s.Pointer<#=k#>;
			else if (<#=j#> == firstNonEmpty && <#=j#> == lastNonEmpty)
				p<#=k#> = s.Pointer<#=k#>.MoveBy(offset, newLength);
			else if (<#=j#> == firstNonEmpty && <#=j#> < lastNonEmpty)
				p<#=k#> = s.Pointer<#=k#>.MoveBy(offset);
			else if (<#=j#> > firstNonEmpty && <#=j#> == lastNonEmpty)
				p<#=k#> = s.Pointer<#=k#>.MoveBy(0, offsetEnd - lenAccu[lastNonEmpty - 1]);

			offset -= s.Pointer<#=k#>.LengthInBytes;
<# } #>
			<# for (int j = 1; j < i; j++) { #>this.Pointer<#=j#> = p<#=j#>; <# } #>this.Pointer<#=i#> = p<#=i#>;
		}
	}
	#endregion


<#	} #>
}